{
  "name": "taskpet",
  "version": "0.1.0-p0",
  "description": "Local-first desktop task assistant shell with a persistent animated pet.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "smoke": "electron . --smoke-test",
    "build": "npm test && electron-builder --dir",
    "build:unpack": "electron-builder --dir",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --universal --publish never",
    "test": "node --test"
  },
  "keywords": [
    "taskpet",
    "desktop-pet",
    "task-assistant",
    "electron"
  ],
  "author": "TaskPet contributors",
  "license": "MIT",
  "devDependencies": {
    "electron": "28.2.9",
    "electron-builder": "^24.13.3"
  }
}
